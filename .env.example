# Production Environment Variables
# Copy this file to .env and fill in the values

# Domain (used for canonical URLs, sitemap)
VITE_SITE_URL=https://ston.ru

# Yandex Metrika Counter ID
VITE_METRIKA_ID=

# CRM API endpoint (for form submissions)
VITE_CRM_API_URL=

# CRM API key (if needed)
# IMPORTANT: Use server-side proxy for private keys — do NOT expose in client code
# VITE_CRM_API_KEY=

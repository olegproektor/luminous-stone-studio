# Production Environment Variables
# Copy this file to .env and fill in the values. Do not commit secrets.

# Domain (used for canonical URLs, sitemap, robots)
VITE_SITE_URL=https://ston.ru

# Yandex Metrika counter ID.
# Leave this empty until the real counter exists. Do not insert a fake numeric ID.
# index.html only reserves a comment slot. When this value is set, src/main.tsx
# calls initAnalytics(), which loads the Metrika tag. Empty = no tag.
VITE_METRIKA_ID=

# ---------------------------------------------------------------------------
# Form delivery
# ---------------------------------------------------------------------------
# mock — local/demo. Accepts the submit in the browser and does not call a server.
# live — browser POSTs JSON to the endpoint for that form.
#
# Required for a real launch:
#   1. VITE_FORM_DELIVERY_MODE=live
#   2. A non-empty HTTPS URL for every form that visitors can submit.
#
# Fail-closed (do not relax):
#   - production build + mode=mock
#       → deliverForm returns { ok: false, status: 503 }
#         "Mock form delivery is disabled in production"
#   - mode=live + empty/missing endpoint for that form
#       → deliverForm returns { ok: false, status: 503 }
#         "Form endpoint is not configured"
#
# Vite inlines every VITE_* value into the public JS bundle.
# Never put a bot token, CRM secret, or other credential in these variables.
#
# JSON body (Content-Type: application/json). Form fields, plus:
#   _form        form id (see map below)
#   _source      page path, e.g. /request-project
#   _timestamp   ISO time
#   consent      "true"
#   utm_source, utm_medium, utm_campaign, utm_term, utm_content
#   yclid, gclid, fbclid
# UTM and click ids are included only when they were captured.
# The honeypot field is website_url; a filled honeypot is dropped in the browser
# and is not delivered.
#
# Endpoint map (env var → form id → UI):
#   VITE_FORM_ENDPOINT_CONTACT        contact_general        contacts form
#   VITE_FORM_ENDPOINT_PROJECT        request_project        request-project / for-objects
#   VITE_FORM_ENDPOINT_PRICE          request_price          price request
#   VITE_FORM_ENDPOINT_CATALOG        request_catalog        CatalogRequestForm
#   VITE_FORM_ENDPOINT_CONSULTATION   request_consultation   ConsultationForm + support
#   VITE_FORM_ENDPOINT_CUSTOM         request_custom         custom page
#   VITE_FORM_ENDPOINT_ARCHITECT      architect_lead         reserved architect lead id
#   VITE_FORM_ENDPOINT_DOWNLOAD_GATE  download_gate          gated downloads
#
# The receiver must answer 2xx. Any other status, or a network error, is a failed submit.

VITE_FORM_DELIVERY_MODE=mock

# Per-form delivery endpoints. Empty until live URLs exist.
VITE_FORM_ENDPOINT_CONTACT=
VITE_FORM_ENDPOINT_PROJECT=
VITE_FORM_ENDPOINT_PRICE=
VITE_FORM_ENDPOINT_CATALOG=
VITE_FORM_ENDPOINT_CONSULTATION=
VITE_FORM_ENDPOINT_CUSTOM=
VITE_FORM_ENDPOINT_ARCHITECT=
VITE_FORM_ENDPOINT_DOWNLOAD_GATE=

# Example A — CRM / automation webhook (workable from the browser).
# Uncomment and replace the host. One path per form, or the same URL for all.
# VITE_FORM_DELIVERY_MODE=live
# VITE_FORM_ENDPOINT_CONTACT=https://crm.example.com/hooks/ston/contact
# VITE_FORM_ENDPOINT_PROJECT=https://crm.example.com/hooks/ston/project
# VITE_FORM_ENDPOINT_PRICE=https://crm.example.com/hooks/ston/price
# VITE_FORM_ENDPOINT_CATALOG=https://crm.example.com/hooks/ston/catalog
# VITE_FORM_ENDPOINT_CONSULTATION=https://crm.example.com/hooks/ston/consultation
# VITE_FORM_ENDPOINT_CUSTOM=https://crm.example.com/hooks/ston/custom
# VITE_FORM_ENDPOINT_ARCHITECT=https://crm.example.com/hooks/ston/architect
# VITE_FORM_ENDPOINT_DOWNLOAD_GATE=https://crm.example.com/hooks/ston/download
#
# Example B — Telegram via a server relay, not the Bot API URL.
# Do not set VITE_FORM_ENDPOINT_* to https://api.telegram.org/bot<TOKEN>/sendMessage:
# the token would ship in the public bundle, and sendMessage does not accept this JSON.
# Point the endpoint at a relay you host. The relay reads the JSON above and calls
# sendMessage with a chat_id and BOT_TOKEN that stay on the server.
# VITE_FORM_DELIVERY_MODE=live
# VITE_FORM_ENDPOINT_PROJECT=https://hooks.example.com/telegram/request-project
# Server-side sketch (not part of this repo):
#   const text = JSON.stringify(req.body)  // includes _form, _source, _timestamp, UTM
#   POST https://api.telegram.org/bot${BOT_TOKEN}/sendMessage
#   { "chat_id": CHAT_ID, "text": text }

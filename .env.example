# Production Environment Variables
# Copy this file to .env and fill in the values

# Domain (used for canonical URLs, sitemap, robots)
VITE_SITE_URL=https://ston.ru

# Yandex Metrika Counter ID
VITE_METRIKA_ID=

# Form delivery mode
# mock - local/demo mode, live - direct browser delivery to configured endpoints
VITE_FORM_DELIVERY_MODE=mock

# Per-form delivery endpoints
VITE_FORM_ENDPOINT_CONTACT=
VITE_FORM_ENDPOINT_PROJECT=
VITE_FORM_ENDPOINT_PRICE=
VITE_FORM_ENDPOINT_CATALOG=
VITE_FORM_ENDPOINT_CONSULTATION=
VITE_FORM_ENDPOINT_CUSTOM=
VITE_FORM_ENDPOINT_ARCHITECT=
VITE_FORM_ENDPOINT_DOWNLOAD_GATE=
